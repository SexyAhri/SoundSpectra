{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundSpectra",
  "version": "1.0.1",
  "identifier": "com.soundspectra.desktop",
  "build": {
    "beforeDevCommand": "node scripts/ensure-dev.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "SoundSpectra · 声谱",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#141417",
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "SoundSpectra 桌面频谱",
        "url": "index.html?window=overlay",
        "width": 1000,
        "height": 240,
        "minWidth": 240,
        "minHeight": 80,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": true
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SexyAhri",
    "copyright": "Copyright (C) 2026 SexyAhri",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "Music-reactive desktop scenes and kinetic lyrics",
    "resources": {
      "../LICENSE": "LICENSE",
      "../COPYRIGHT": "COPYRIGHT",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/": "licenses/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NkJGQ0VERTMxRjAzQzAKUldUQUF4L2o3ZnhydDF5Wllmb0lCSlJiT0pOZENnS0l3WXVjbkJ4cjZxK0c4RHk0UkhrbkJqVEcK",
      "endpoints": [
        "https://github.com/SexyAhri/SoundSpectra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "distribution": {
      "repository": "SexyAhri/SoundSpectra"
    }
  }
}
