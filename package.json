{
  "name": "soundspectra",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "SexyAhri",
  "description": "Windows desktop music visualization with kinetic lyrics",
  "repository": {
    "type": "git",
    "url": "https://github.com/SexyAhri/SoundSpectra.git"
  },
  "version": "1.0.10",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:ui": "tsc -b && vite build --outDir artifacts/ui-build",
    "test:ui": "npm run build:ui && playwright test --config=playwright.ui.config.ts tests/effect-settings.spec.ts tests/performance-placement.spec.ts tests/inspector-layout.spec.ts tests/rail.spec.ts tests/studio.spec.ts tests/wallpaper-depth.spec.ts tests/music-card.spec.ts tests/workspace-experience.spec.ts tests/workspace-layout.spec.ts tests/settings.spec.ts tests/application.spec.ts tests/desktop-scenes.spec.ts tests/valley-library.spec.ts tests/theme.spec.ts tests/lyrics.spec.ts tests/audio-sources.spec.ts",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs",
    "doctor": "node scripts/desktop.mjs --check",
    "check:full": "node scripts/check-full.mjs",
    "test": "playwright test",
    "visual:compare": "node scripts/visual-compare.mjs",
    "test:smoke": "playwright test tests/application.spec.ts tests/workspace-layout.spec.ts tests/lyrics.spec.ts",
    "desktop:build": "node scripts/desktop.mjs --build",
    "release:prepare": "node scripts/release-config.mjs",
    "release:setup": "node scripts/setup-release.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "test:release": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@react-three/fiber": "9.8.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "animejs": "4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
